# ── Required ──────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_GENAI_USE_VERTEXAI=True

# ── GitHub (required for PR comments and release creation) ────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_OWNER=weimeilin79
# GITHUB_REPO=dinoquest-io

# ── Slack post-back ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
# SLACK_WEBHOOK_SECRET=projects/your-project/secrets/cd-slack-webhook/versions/latest

# ── Pub/Sub event bus (required for dino-theater visualization) ───────────────
HARNESS_EVENTS_TOPIC=projects/your-gcp-project-id/topics/harness-events

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Skips canary metrics (instant OK), Firestore pattern write, GitHub release creation
# Deploy and traffic shifts still run for real
DEMO_MODE=false

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# CLOUD_RUN_REGION=us-central1
# CD_TARGET_SERVICE=dinoquest
# PORT=8080

# Note: CDAgent uses Application Default Credentials (ADC) for all GCP APIs
# (Cloud Run, Cloud Monitoring, Firestore). No service account key file needed.
# Locally: run `gcloud auth application-default login`
# On Cloud Run: attach the cd-agent service account via --service-account flag.
