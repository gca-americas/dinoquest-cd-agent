# ── Required ──────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_GENAI_USE_VERTEXAI=True
# ── Pub/Sub event bus (required for dino-theater visualization) ───────────────
HARNESS_EVENTS_TOPIC=projects/your-gcp-project-id/topics/harness-events

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# CLOUD_RUN_REGION=us-central1
# CD_TARGET_SERVICE=dinoquest
# PORT=8080

# Note: CDAgent uses Application Default Credentials (ADC) for all GCP APIs
# (Cloud Run, Cloud Monitoring, Firestore). No service account key file needed.
# Locally: run `gcloud auth application-default login`
# On Cloud Run: attach the cd-agent service account via --service-account flag.
